# Server Configuration
PORT=
NODE_ENV=
FRONTEND_URL=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ChromaDB Configuration (requires ChromaDB server running)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# AI Provider (gemini or openai)
AI_PROVIDER=gemini

# Google Gemini Configuration (recommended - FREE!)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSION=768

# OpenAI Configuration (alternative)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=

# Database Configuration
DATABASE_PATH=./data/code-chat.db

# Cache Configuration
CACHE_TTL=
CACHE_PREFIX=

# LLM Configuration
LLM_MAX_TOKENS=
LLM_TEMPERATURE=

# RAG Configuration
MAX_CONTEXT_CHUNKS=
MIN_SIMILARITY=

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# GitHub Repository Storage
REPO_STORAGE_PATH=
REPO_MAX_SIZE_MB=

# Token Encryption
ENCRYPTION_KEY=

EXA_API_KEY=
