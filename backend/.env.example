# Server Configuration
PORT=
NODE_ENV=
FRONTEND_URL=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ChromaDB Configuration (requires ChromaDB server running)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# AI Provider (gemini or openai)
AI_PROVIDER=gemini

# Google Gemini Configuration (recommended - FREE!)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSION=768

# OpenAI Configuration (alternative)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=

# Database Configuration
DATABASE_PATH=./data/code-chat.db

# Cache Configuration
CACHE_TTL=
CACHE_PREFIX=

# LLM Provider Configuration
# Choose LLM provider for code generation: 'gemini' or 'groq'
# Groq provides ultra-fast inference with Llama models (recommended for speed)
# Gemini provides high-quality responses with advanced reasoning
LLM_PROVIDER=gemini

# Groq Configuration (for ultra-fast code generation)
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=
# Available models: llama-3.3-70b-versatile, llama-3.1-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# LLM Configuration (applies to both providers)
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.1

# RAG Configuration
MAX_CONTEXT_CHUNKS=
MIN_SIMILARITY=

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# GitHub Repository Storage
REPO_STORAGE_PATH=
REPO_MAX_SIZE_MB=

# Token Encryption
ENCRYPTION_KEY=

EXA_API_KEY=
